[Unit]
Description=ERM 2026 - recepcion de evidencias ciudadanas
After=network.target

[Service]
User=ermintake
Group=ermintake
Environment=PORT=8833 INBOX=/var/lib/erm2026-intake
EnvironmentFile=-/etc/erm2026-intake.env
ExecStart=/usr/bin/node /opt/erm2026-intake/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/erm2026-intake
MemoryMax=512M

[Install]
WantedBy=multi-user.target
