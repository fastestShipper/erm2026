[Unit]
Description=ERM 2026 - publico en vivo (personas viendo y reacciones)
After=network.target

[Service]
DynamicUser=yes
StateDirectory=erm2026-viewers
Environment=PORT=8833 FEED_PATH=/srv/erm2026/data/bots/feed.json
ExecStart=/usr/bin/node /opt/erm2026-viewers/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=384M

[Install]
WantedBy=multi-user.target
